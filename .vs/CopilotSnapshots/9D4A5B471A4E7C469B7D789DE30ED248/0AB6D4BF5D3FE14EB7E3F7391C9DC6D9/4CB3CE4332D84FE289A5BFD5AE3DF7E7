.home {
    grid-template-columns: 20% 60% 20%;
    grid-template-rows: 20% 60% 20%;

    justify-content: center;
    align-content: center;

    height: 100vh;

    grid-template-areas: 
        ". top ."
        "left center right"
        ". bottom ."
 }

.up {
    grid-area: up;
}

.left {
    grid-area: left;
}

.right {
    grid-area: right;
}

.down {
    grid-area: down; 
}

.center {
    grid-area: center;
}